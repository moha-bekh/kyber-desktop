#!/usr/bin/env bash

set -euo pipefail

LABEL="tech.kyber.server"
PLIST="/Library/LaunchAgents/${LABEL}.plist"
SHARED_DIR="/Users/Shared/Kyber-Server"

die() { echo "[postinstall] ERROR: $*" >&2; exit 1; }

if [[ ! -d "$SHARED_DIR" ]]; then
    mkdir -p "$SHARED_DIR"
fi
chmod 1777 "$SHARED_DIR"
chown root:wheel "$SHARED_DIR"

for f in "${SHARED_DIR}/out.log" "${SHARED_DIR}/err.log"; do
    [[ -f "$f" ]] || touch "$f"
    chmod 666 "$f"
done

[[ -f "$PLIST" ]] || die "Plist not found after install: ${PLIST}"
chown root:wheel "$PLIST"
chmod 644 "$PLIST"

get_gui_uid() {
    local uid
    uid=$(scutil <<< "show State:/Users/ConsoleUser" 2>/dev/null \
          | awk '/^ *UID *:/{print $3}')
    [[ -z "$uid" || "$uid" == "0" ]] && echo "" || echo "$uid"
}

uid=$(get_gui_uid)

if [[ -z "$uid" ]]; then
    echo "[postinstall] No GUI session — agent will load at next login."
    exit 0
fi

postinstall_log="${SHARED_DIR}/postinstall.log"

if launchctl print "gui/${uid}/${LABEL}" &>/dev/null; then
    launchctl bootout "gui/${uid}/${LABEL}" 2>/dev/null || true
    # bootout seems asynchronous — bootstrapping before the old service is fully
    # torn down may fails with error "Bootstrap failed: 5: Input/output error"
    # hence one does some poll based checks to confirm service has been completely
    # booted out
    for _ in $(seq 1 20); do
        launchctl print "gui/${uid}/${LABEL}" &>/dev/null || break
        sleep 0.25
    done
fi

if err=$(launchctl bootstrap "gui/${uid}" "$PLIST" 2>&1 >/dev/null); then
    echo "[postinstall] Agent bootstrapped for uid ${uid}." >> "$postinstall_log"
else
    rc=$?
    echo "[postinstall] launchctl bootstrap exited ${rc}: ${err}" >> "$postinstall_log"
    die "launchctl bootstrap failed (rc=${rc}): ${err}"
fi

# macOS TCC database retains stale permission entries across reinstalls,
# causing new permission grants to be silently ignored. Resetting forces a clean prompt.
tccutil reset All "${LABEL}" 2>"$postinstall_log" || true

exit 0
